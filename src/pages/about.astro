---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ImagePlaceholder from "../components/ImagePlaceholder.astro";
import CallToAction from "../components/CallToAction.astro";
import { site } from "../site.config";

const page = await getEntry("pages", "about");
if (!page) throw new Error("Missing src/content/pages/about.md");
const { Content } = await render(page);
const p = page.data;
---

<BaseLayout title={p.title} description={p.description}>
  <section class="section">
    <div class="container about-grid">
      <div class="prose">
        <h1>{p.heading}</h1>
        {p.intro && <p class="lead">{p.intro}</p>}
        <Content />
        <h2>Get in touch</h2>
        <p>
          The easiest way to start is a <a href="/book/">free 15-minute fit call</a>. You can also email me at
          <a href={`mailto:${site.owner.email}`}>{site.owner.email}</a>.
        </p>
      </div>
      <div class="photo">
        <ImagePlaceholder alt="Photo of Brian, founder of GuidedCare" label="Photo of Brian (placeholder)" ratio="4 / 5" />
      </div>
    </div>
  </section>
  <CallToAction />
</BaseLayout>

<style>
  .about-grid { display: grid; gap: var(--space-4); align-items: start; }
  @media (min-width: 56rem) {
    .about-grid { grid-template-columns: 3fr 2fr; }
    .photo { position: sticky; top: var(--space-3); }
  }
</style>
