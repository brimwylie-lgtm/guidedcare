---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Headshot from "../components/Headshot.astro";
import CallToAction from "../components/CallToAction.astro";
import { site } from "../site.config";

const page = await getEntry("pages", "about");
if (!page) throw new Error("Missing src/content/pages/about.md");
const { Content } = await render(page);
const p = page.data;
---

<BaseLayout title={p.title} description={p.description}>
  <section class="section">
    <div class="container">
      <div class="prose">
        <h1>{p.heading}</h1>
        {p.intro && <p class="lead">{p.intro}</p>}
        <Headshot size={120} name="Brian" role="Founder, GuidedCare" />
        <Content />
        <h2>Get in touch</h2>
        <p>
          The easiest way to start is a <a href="/book/">free 15-minute fit call</a>. You can also email
          <a href={`mailto:${site.owner.email}`}>{site.owner.email}</a>.
        </p>
      </div>
    </div>
  </section>
  <CallToAction />
</BaseLayout>
