---
import "@fontsource-variable/source-sans-3";
import "@fontsource-variable/source-serif-4";
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../site.config";

interface Props {
  title: string;
  description: string;
  schema?: boolean;
}
const { title, description, schema } = Astro.props;
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#183f4f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo title={title} description={description} schema={schema} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    {
      !site.indexable && (
        <div class="preview-banner" role="note">
          Preview site, work in progress. Details and prices may change.
        </div>
      )
    }
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -10rem;
    z-index: 100;
    background: var(--harbour-deep);
    color: #fff;
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    font-weight: 700;
  }
  .skip-link:focus { top: 1rem; }
  main:focus { outline: none; }
  .preview-banner {
    background: var(--peach);
    color: var(--ink);
    text-align: center;
    font-size: var(--step--1);
    padding: 0.4rem 1rem;
  }
</style>
